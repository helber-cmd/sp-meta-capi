generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LeadContext {
  id        String   @id @default(uuid())
  lead_id   String   @unique
  afp       String?  
  // cookies/ids
  fbp       String?
  fbc       String?
  fbclid    String?
  // PII para advanced matching
  phone     String?
  email     String?
  // utms
  // utms
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_content  String?
  // device
  client_ip_address   String?
  client_user_agent   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([afp])
  @@index([createdAt])
}

model EventLog {
  id        String   @id @default(uuid())
  type      String
  provider  String
  extra     String?
  createdAt DateTime @default(now())
}

model AdMetrics {
  id             String   @id @default(uuid())
  uniqueId       String   @unique
  day            String
  accountId      String
  accountName    String?
  campaignName   String
  adsetName      String?
  adName         String?
  funil          String?
  amountSpent    Float    @default(0)
  impressions    Int      @default(0)
  linkClicks     Int      @default(0)
  cpm            Float    @default(0)
  ctr            Float    @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  @@index([day])
  @@index([campaignName])
  @@index([accountId])
}
