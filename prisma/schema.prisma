// ======================================
// 🔙 VERSÃO ORIGINAL (LIMPA)
// Sem player_id, sem has_deposited.
// Apenas o essencial para rastrear o Lead.
// ======================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LeadContext {
  id        String   @id @default(uuid())
  lead_id   String   @unique
  afp       String?  
  
  // Dados do Meta
  fbp             String?
  fbc             String?
  fbclid          String?
  
  // UTMs
  utm_source      String?
  utm_medium      String?
  utm_campaign    String?
  utm_content     String?
  
  // Dados Técnicos
  client_ip_address String?
  client_user_agent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([afp])
}

model EventLog {
  id        String   @id @default(uuid())
  type      String   // "registro", "deposito"
  provider  String   // "novibet"
  createdAt DateTime @default(now())
}
