model AdMetrics {
  id             String   @id @default(uuid())
  uniqueId       String   @unique
  day            String
  accountId      String
  accountName    String?
  campaignName   String
  adsetName      String?
  adName         String?
  amountSpent    Float    @default(0)
  impressions    Int      @default(0)
  linkClicks     Int      @default(0)
  cpm            Float    @default(0)
  ctr            Float    @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([day])
  @@index([campaignName])
  @@index([accountId])
}
